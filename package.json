{
  "name": "rugu-cloud",
  "version": "1.0.0",
  "private": true,
  "description": "如故云题库 — Cloudflare Pages + D1 + KV",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:local": "wrangler d1 execute rugu-cloud-db --local --file=./schema.sql",
    "db:local:fix": "node scripts/apply-local-schema.mjs",
    "db:remote": "wrangler d1 execute rugu-cloud-db --remote --file=./schema.sql",
    "migrate:rugu": "node scripts/migrate-from-rugu.mjs",
    "smoke": "node scripts/smoke-api.mjs",
    "smoke:isolation": "node scripts/smoke-isolation.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "wrangler": "^4.14.0"
  }
}
